# FitBuddy Environment Configuration
APP_NAME="FitBuddy"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database
DATABASE_URL="sqlite:///./fitbuddy.db"

# Google Gemini AI Configuration
# Set your Gemini API key here. If empty or invalid, FitBuddy seamlessly falls back to high-fidelity structured heuristic planning engine for zero-downtime offline usage.
GEMINI_API_KEY=""

# Gemini Models
GEMINI_WORKOUT_MODEL="gemini-1.5-pro"
GEMINI_NUTRITION_MODEL="gemini-1.5-flash"
